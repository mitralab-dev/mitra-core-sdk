{
  "_source": "template/agent-box-sidecar (mitra-sandbox), test/fixtures.test.ts",
  "endpoint": "POST {deliveryUrl}/{taskId}/channel-events",
  "note": "The turn's events as they are logged, in short batches in the log's order (the text of an answer whole in one batch, when what follows it is logged), resent from `consumedThrough` until 2xx; the copilot keeps each event once by its `sequence`, records the turn under the first of `turnIds`, and closes it with the batch that has `final: true`. A turn the provider opened on its own goes with `turnIds: []` and `providerWake: true` and `wakeId` on each event. `sequence` orders the rows of the thread's log; `timestamp` is epoch ms of when the box logged the frame. The answer is {consumedThrough: <the highest sequence the copilot holds>}.",
  "requests": [
    {
      "path": "/api/v1/tasks/task-1/channel-events",
      "header": {
        "X-Mitra-Chat-Grant": "<delivery credential>"
      },
      "body": {
        "generation": 2,
        "threadId": "thread:project:<projectId>:<uuid>",
        "turnIds": ["turn-1"],
        "events": [
          {
            "type": "stepStart",
            "payload": {
              "lifecycle": {
                "activityId": "act-1",
                "turnId": "turn-1",
                "turnSequence": 1,
                "terminal": false,
                "sessionIdle": false,
                "interruptTerminal": false,
                "clientMessageId": "cm-1"
              }
            },
            "sequence": 2,
            "timestamp": 1760600000030
          },
          {
            "type": "textChunk",
            "payload": {
              "text": "Let me look.\n\n",
              "kind": "text",
              "lifecycle": {
                "activityId": "act-1",
                "turnId": "turn-1",
                "turnSequence": 1,
                "terminal": false,
                "sessionIdle": false,
                "interruptTerminal": false
              },
              "itemId": "a1",
              "itemDelta": "Let me look.\n\n"
            },
            "sequence": 3,
            "timestamp": 1760600000040
          },
          {
            "type": "toolCall",
            "payload": {
              "toolId": "tool-1",
              "name": "command_execution",
              "title": "ls",
              "input": {
                "command": "ls"
              },
              "lifecycle": {
                "activityId": "act-1",
                "turnId": "turn-1",
                "turnSequence": 1,
                "terminal": false,
                "sessionIdle": false,
                "interruptTerminal": false
              },
              "itemId": "tool-1"
            },
            "sequence": 4,
            "timestamp": 1760600000050
          },
          {
            "type": "toolResult",
            "payload": {
              "toolId": "tool-1",
              "name": "command_execution",
              "title": "ls",
              "output": "a.txt\nb.txt",
              "isError": false,
              "lifecycle": {
                "activityId": "act-1",
                "turnId": "turn-1",
                "turnSequence": 1,
                "terminal": false,
                "sessionIdle": false,
                "interruptTerminal": false
              },
              "itemId": "tool-1"
            },
            "sequence": 5,
            "timestamp": 1760600000060
          },
          {
            "type": "textChunk",
            "payload": {
              "text": "Two files.",
              "kind": "text",
              "lifecycle": {
                "activityId": "act-1",
                "turnId": "turn-1",
                "turnSequence": 1,
                "terminal": false,
                "sessionIdle": false,
                "interruptTerminal": false
              },
              "itemId": "a2",
              "itemDelta": "Two files."
            },
            "sequence": 6,
            "timestamp": 1760600000070
          },
          {
            "type": "stepFinish",
            "payload": {
              "reason": "stop",
              "turnId": "run-1",
              "usage": {
                "inputTokens": 1000,
                "outputTokens": 80,
                "cacheReadTokens": 200,
                "model": "fake-model",
                "provider": "claudeAgent",
                "durationMs": 2500
              },
              "lifecycle": {
                "activityId": "act-1",
                "turnId": "turn-1",
                "turnSequence": 1,
                "terminal": true,
                "sessionIdle": true,
                "interruptTerminal": false
              }
            },
            "sequence": 7,
            "timestamp": 1760600000080
          }
        ],
        "final": true
      }
    }
  ]
}
